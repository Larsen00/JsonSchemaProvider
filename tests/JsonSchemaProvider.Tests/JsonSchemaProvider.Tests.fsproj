<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xUnit v3 defaults to Microsoft.Testing.Platform, which the .NET 10 SDK rejects under the VSTest dotnet test. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Debug.fsx" />
    <Compile Include="TestHelpers.fs" />
    <!-- Keywords/: black-box coverage of JSON Schema keyword families, one file per family. -->
    <Compile Include="Keywords/NumberKeywordTests.fs" />
    <Compile Include="Keywords/StringKeywordTests.fs" />
    <Compile Include="Keywords/ArrayKeywordTests.fs" />
    <Compile Include="Keywords/ObjectKeywordTests.fs" />
    <Compile Include="Keywords/OneOfTests.fs" />
    <Compile Include="Keywords/OneOfObjectBranchTests.fs" />
    <!-- Mechanisms/: provider plumbing, not a single keyword (static params, flags, Path resolution). -->
    <Compile Include="Mechanisms/RootTypeTests.fs" />
    <Compile Include="Mechanisms/SchemaFileTests.fs" />
    <Compile Include="Mechanisms/SkipRuntimeValidationTests.fs" />
    <Compile Include="Mechanisms/NestedValidationTests.fs" />
    <Compile Include="Mechanisms/NullInputTests.fs" />
    <!-- Compatibility/: parity against an external tool's own fixture schemas, not our own design. -->
    <Compile Include="Compatibility/OldCodeGenerationTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.0.102" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="altcover" Version="9.0.102" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="FsCheck.Xunit.v3" Version="3.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="FSharp.Data.Json.Core" Version="6.6.0" />
    <PackageReference Include="NJsonSchema" Version="11.5.2" />
    <PackageReference Include="FSharp.TypeProviders.SDK" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- <Reference Include="JsonSchemaProvider">
      <HintPath Condition="Exists('..\..\src\JsonSchemaProvider.Runtime\bin\Debug\netstandard2.0\JsonSchemaProvider.dll')">..\..\src\JsonSchemaProvider.Runtime\bin\Debug\netstandard2.0\JsonSchemaProvider.dll</HintPath>
      <HintPath Condition="Exists('..\..\src\JsonSchemaProvider.Runtime\bin\Release\netstandard2.0\JsonSchemaProvider.dll')">..\..\src\JsonSchemaProvider.Runtime\bin\Release\netstandard2.0\JsonSchemaProvider.dll</HintPath>
    </Reference>
    <Reference Include="JsonSchemaProvider.DesignTime">
      <HintPath Condition="Exists('..\..\src\JsonSchemaProvider.Runtime\bin\Debug\netstandard2.0\JsonSchemaProvider.DesignTime.dll')">..\..\src\JsonSchemaProvider.Runtime\bin\Debug\netstandard2.0\JsonSchemaProvider.DesignTime.dll</HintPath>
      <HintPath Condition="Exists('..\..\src\JsonSchemaProvider.Runtime\bin\Release\netstandard2.0\JsonSchemaProvider.DesignTime.dll')">..\..\src\JsonSchemaProvider.Runtime\bin\Release\netstandard2.0\JsonSchemaProvider.DesignTime.dll</HintPath>
    </Reference> -->
    <ProjectReference Include="..\..\src\JsonSchemaProvider.Runtime\JsonSchemaProvider.fsproj" />
    <ProjectReference Include="..\..\src\JsonSchemaProvider.DesignTime\JsonSchemaProvider.DesignTime.fsproj" />
  </ItemGroup>
</Project>